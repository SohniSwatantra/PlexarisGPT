# =============================================================================
# PLEXARIS - Git Ignore
# =============================================================================

# Environment files (NEVER commit these!)
.env
.env.local
.env.development
.env.production
.env*.local
backend/.env
frontend/.env.local

# Dependencies
node_modules/
frontend/node_modules/
backend/venv*/
backend/__pycache__/
backend/**/__pycache__/
*.pyc
*.pyo
*.pyd

# Build outputs
frontend/.next/
frontend/out/
frontend/build/
.next/
dist/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Testing
coverage/
.nyc_output/
.pytest_cache/

# Misc
*.local
.vercel
.netlify/

# OS
Thumbs.db
.DS_Store

# Secrets (extra safety)
*.pem
*.key
credentials.json
secrets.json
