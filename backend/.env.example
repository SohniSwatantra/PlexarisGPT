# =============================================================================
# PLEXARIS BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# =============================================================================

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# OpenRouter API (for AI/LLM features)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_API_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o
EMBEDDING_MODEL=openai/text-embedding-3-small

# Neon Auth
NEON_AUTH_URL=https://your-project.neonauth.region.aws.neon.tech/database/auth
NEON_AUTH_JWKS_URL=https://your-project.neonauth.region.aws.neon.tech/database/auth/.well-known/jwks.json

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Server Configuration
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://your-netlify-app.netlify.app

# Performance Tuning
CONVO_HISTORY_LENGTH=6
PRODUCT_LIMIT=3

# Optional: API Key Protection (leave empty to disable)
API_ACCESS_KEY=
